{
  "name": "assay-harness",
  "version": "0.10.3",
  "description": "Approval-aware resumable harness with Assay policy and evidence governance",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "assay-harness": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "src",
    "scripts",
    "test",
    "suite-compatibility.json",
    "policy.yaml",
    "tsconfig.json",
    "!scripts/probe-v54-enforcement-health.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "run:harness": "tsx src/cli.ts run",
    "run:verify": "tsx src/cli.ts verify",
    "test": "npm run build && npm run check:hotspots && node --test test/*.mjs",
    "test:fuzz": "npm run build && node --test test/suite_evidence_pack_fuzz.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:hotspots": "node scripts/check-hotspot-loc.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@openai/agents": "^0.17.0",
    "js-yaml": "^5.4.1",
    "openai": "^7.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
